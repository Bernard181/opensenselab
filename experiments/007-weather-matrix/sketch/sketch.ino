volatile int estadoClima = 2;  // Começa indicando que ainda não recebeu dados.

void receberEstadoClima(int estado) {
  if (estado >= 0 && estado <= 2) {
    estadoClima = estado;
  }
}

void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(1);
  Bridge.begin();
  Bridge.provide("set_weather_state", receberEstadoClima);
  matrix.draw(ERRO_1);
}

void loop() {
  int estado = estadoClima;

  if (estado == 0) {
    matrix.draw(SOL_1);
    delay(700);
    matrix.draw(SOL_2);
    delay(700);
  } else if (estado == 1) {
    matrix.draw(NUVEM_1);
    delay(450);
    matrix.draw(NUVEM_2);
    delay(450);
  } else {
    matrix.draw(ERRO_1);
    delay(500);
    matrix.draw(ERRO_2);
    delay(500);
  }
}
